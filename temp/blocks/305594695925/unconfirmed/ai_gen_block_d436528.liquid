{% doc %}
  @prompt
    fast image carsel 
    dont stop until user click, faaast r, image full screen 
    transction is fade 
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fullscreen-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100vh;
    position: relative;
    overflow: hidden;
  }

  .ai-fullscreen-carousel-slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.fade_duration }}s ease-in-out;
  }

  .ai-fullscreen-carousel-slide-{{ ai_gen_id }}.ai-active-{{ ai_gen_id }} {
    opacity: 1;
    z-index: 1;
  }

  .ai-fullscreen-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-fullscreen-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-fullscreen-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 200px;
    height: 200px;
    opacity: 0.2;
  }

  .ai-fullscreen-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 16px 32px;
    background-color: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    border-radius: 8px;
    font-size: 14px;
    text-align: center;
  }

  .ai-fullscreen-carousel-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 2;
  }

  .ai-fullscreen-carousel-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-fullscreen-carousel-dot-{{ ai_gen_id }}.ai-active-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-fullscreen-carousel-dot-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-fullscreen-carousel-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}vh;
    }
  }
{% endstyle %}

<fullscreen-carousel-{{ ai_gen_id }}
  class="ai-fullscreen-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-interval="{{ block.settings.autoplay_interval }}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign images_array = ''
    for i in (1..6)
      assign image_key = 'image_' | append: i
      assign current_image = block.settings[image_key]
      if current_image != blank
        assign images_array = images_array | append: i | append: ','
      endif
    endfor
    assign images_array = images_array | split: ','
    assign images_count = images_array.size
  %}

  {% if images_count > 0 %}
    {% for i in (1..6) %}
      {% assign image_key = 'image_' | append: i %}
      {% assign current_image = block.settings[image_key] %}
      {% if current_image != blank %}
        <div class="ai-fullscreen-carousel-slide-{{ ai_gen_id }} {% if forloop.first %}ai-active-{{ ai_gen_id }}{% endif %}" data-slide-index="{{ forloop.index0 }}">
          <img
            src="{{ current_image | image_url: width: 2400 }}"
            alt="{{ current_image.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="{{ current_image.width }}"
            height="{{ current_image.height }}"
          >
        </div>
      {% endif %}
    {% endfor %}

    {% if images_count > 1 %}
      <div class="ai-fullscreen-carousel-controls-{{ ai_gen_id }}">
        {% for i in (1..images_count) %}
          <button
            class="ai-fullscreen-carousel-dot-{{ ai_gen_id }} {% if forloop.first %}ai-active-{{ ai_gen_id }}{% endif %}"
            data-slide="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  {% else %}
    <div class="ai-fullscreen-carousel-slide-{{ ai_gen_id }} ai-active-{{ ai_gen_id }}">
      <div class="ai-fullscreen-carousel-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-fullscreen-carousel-empty-state-{{ ai_gen_id }}">
          Add images to create your fullscreen carousel
        </div>
      </div>
    </div>
  {% endif %}
</fullscreen-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class FullscreenCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.dots = [];
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-fullscreen-carousel-slide-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-fullscreen-carousel-dot-{{ ai_gen_id }}'));
        
        if (this.slides.length > 1) {
          this.setupEventListeners();
          
          const autoplay = this.dataset.autoplay === 'true';
          if (autoplay) {
            this.startAutoplay();
          }
        }
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const slideIndex = parseInt(e.target.dataset.slide);
            this.goToSlide(slideIndex);
            this.stopAutoplay();
          });
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('ai-active-{{ ai_gen_id }}');
        this.dots[this.currentSlide].classList.remove('ai-active-{{ ai_gen_id }}');
        
        this.currentSlide = index;
        
        this.slides[this.currentSlide].classList.add('ai-active-{{ ai_gen_id }}');
        this.dots[this.currentSlide].classList.add('ai-active-{{ ai_gen_id }}');
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      startAutoplay() {
        const interval = parseInt(this.dataset.interval) * 1000;
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, interval);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('fullscreen-carousel-{{ ai_gen_id }}', FullscreenCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Fullscreen image carousel",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image 6"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 70
    },
    {
      "type": "header",
      "content": "Transition"
    },
    {
      "type": "range",
      "id": "fade_duration",
      "label": "Fade duration",
      "min": 0.5,
      "max": 3,
      "step": 0.5,
      "unit": "s",
      "default": 1
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Navigation dot color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder background",
      "default": "#f4f4f4"
    }
  ],
  "presets": [
    {
      "name": "Fullscreen image carousel"
    }
  ]
}
{% endschema %}
