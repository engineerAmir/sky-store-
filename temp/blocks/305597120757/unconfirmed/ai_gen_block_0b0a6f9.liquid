{% doc %}
  @prompt
    i need hero section 
    is fullscreen iameges 
    transction betwen images is fade 
    loob 
    do not stop untill user click , Create a modern fullscreen hero section with a background image slider.
    
    Requirements:
    - Hero section must take 100vh (full screen).
    - Use high-quality fullscreen background images with cover sizing.
    - Images should automatically transition using a smooth fade animation.
    - Enable infinite looping.
    - Autoplay should never stop or pause.
    - Do not pause on hover, focus, or interaction.
    - The slider should continue changing images until the user manually clicks the previous or next navigation buttons.
    - Fade transition duration: 1–1.5 seconds.
    - Autoplay interval: 4–5 seconds.
    - Preload the next image for smooth transitions.
    - Add a subtle dark overlay (40–50%) to improve text readability.
    - Keep all text and CTA buttons centered vertically and horizontally.
    - Ensure the hero is fully responsive on desktop, tablet, and mobile.
    - Optimize for performance with smooth GPU-accelerated animations and no layout shifts.
    - Include previous/next arrows and optional pagination dots.
    - Respect accessibility by keeping text readable over every image.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fullscreen-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .ai-fullscreen-hero__slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-fullscreen-hero__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.fade_duration }}s ease-in-out;
    will-change: opacity;
  }

  .ai-fullscreen-hero__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    z-index: 1;
  }

  .ai-fullscreen-hero__slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-fullscreen-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .ai-fullscreen-hero__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    text-align: center;
    width: 90%;
    max-width: 800px;
    color: {{ block.settings.text_color }};
  }

  .ai-fullscreen-hero__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 20px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-fullscreen-hero__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 30px;
    line-height: 1.5;
    opacity: 0.95;
  }

  .ai-fullscreen-hero__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: transform 0.3s ease, background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-fullscreen-hero__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-fullscreen-hero__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    background-color: rgba(255, 255, 255, 0.2);
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease, transform 0.2s ease;
    backdrop-filter: blur(10px);
  }

  .ai-fullscreen-hero__nav-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-50%) scale(1.1);
  }

  .ai-fullscreen-hero__nav-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: {{ block.settings.nav_color }};
  }

  .ai-fullscreen-hero__nav--prev-{{ ai_gen_id }} {
    left: 30px;
  }

  .ai-fullscreen-hero__nav--next-{{ ai_gen_id }} {
    right: 30px;
  }

  .ai-fullscreen-hero__dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    gap: 12px;
  }

  .ai-fullscreen-hero__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    padding: 0;
  }

  .ai-fullscreen-hero__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-fullscreen-hero__dot-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.6);
  }

  .ai-fullscreen-hero__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-fullscreen-hero__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
    opacity: 0.3;
  }

  .ai-fullscreen-hero__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 60px;
    left: 50%;
    transform: translateX(-50%);
    padding: 16px 24px;
    font-size: 16px;
    color: #ffffff;
    text-align: center;
    pointer-events: none;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 8px;
  }

  @media screen and (max-width: 989px) {
    .ai-fullscreen-hero__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-fullscreen-hero__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.85);
    }

    .ai-fullscreen-hero__button-{{ ai_gen_id }} {
      padding: 14px 32px;
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
    }

    .ai-fullscreen-hero__nav-{{ ai_gen_id }} {
      width: 44px;
      height: 44px;
    }

    .ai-fullscreen-hero__nav--prev-{{ ai_gen_id }} {
      left: 20px;
    }

    .ai-fullscreen-hero__nav--next-{{ ai_gen_id }} {
      right: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-fullscreen-hero__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.5);
      margin-bottom: 16px;
    }

    .ai-fullscreen-hero__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.75);
      margin-bottom: 24px;
    }

    .ai-fullscreen-hero__button-{{ ai_gen_id }} {
      padding: 12px 28px;
      font-size: calc({{ block.settings.button_font_size }}px * 0.85);
    }

    .ai-fullscreen-hero__nav-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-fullscreen-hero__nav--prev-{{ ai_gen_id }} {
      left: 15px;
    }

    .ai-fullscreen-hero__nav--next-{{ ai_gen_id }} {
      right: 15px;
    }

    .ai-fullscreen-hero__dots-{{ ai_gen_id }} {
      bottom: 30px;
      gap: 10px;
    }

    .ai-fullscreen-hero__dot-{{ ai_gen_id }} {
      width: 10px;
      height: 10px;
    }
  }
{% endstyle %}

<fullscreen-hero-slider-{{ ai_gen_id }}
  class="ai-fullscreen-hero-{{ ai_gen_id }}"
  data-interval="{{ block.settings.autoplay_interval }}"
  data-fade-duration="{{ block.settings.fade_duration }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-fullscreen-hero__slider-{{ ai_gen_id }}">
    {% liquid
      assign has_images = false
      for i in (1..5)
        assign image_key = 'image_' | append: i
        if block.settings[image_key] != blank
          assign has_images = true
          break
        endif
      endfor
    %}

    {% if has_images %}
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}

        {% if image != blank %}
          <div class="ai-fullscreen-hero__slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index }}">
            <img
              src="{{ image | image_url: width: 2400 }}"
              srcset="{{ image | image_url: width: 1200 }} 1200w,
                      {{ image | image_url: width: 1800 }} 1800w,
                      {{ image | image_url: width: 2400 }} 2400w"
              sizes="100vw"
              alt="{{ image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="ai-fullscreen-hero__slide-{{ ai_gen_id }} active" data-slide="1">
        <div class="ai-fullscreen-hero__placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-fullscreen-hero__empty-state-{{ ai_gen_id }}">
            Add background images to create your hero slider
          </div>
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-fullscreen-hero__overlay-{{ ai_gen_id }}"></div>

  <div class="ai-fullscreen-hero__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-fullscreen-hero__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-fullscreen-hero__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}

    {% if block.settings.button_label != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-fullscreen-hero__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_label }}
      </a>
    {% endif %}
  </div>

  {% if has_images and block.settings.show_navigation %}
    <button
      class="ai-fullscreen-hero__nav-{{ ai_gen_id }} ai-fullscreen-hero__nav--prev-{{ ai_gen_id }}"
      aria-label="Previous slide"
      data-direction="prev"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button
      class="ai-fullscreen-hero__nav-{{ ai_gen_id }} ai-fullscreen-hero__nav--next-{{ ai_gen_id }}"
      aria-label="Next slide"
      data-direction="next"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  {% endif %}

  {% if has_images and block.settings.show_dots %}
    <div class="ai-fullscreen-hero__dots-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}

        {% if image != blank %}
          <button
            class="ai-fullscreen-hero__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            aria-label="Go to slide {{ forloop.index }}"
            data-slide-index="{{ forloop.index | minus: 1 }}"
          ></button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</fullscreen-hero-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class FullscreenHeroSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.intervalId = null;
        this.isAutoplayActive = true;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-fullscreen-hero__slide-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-fullscreen-hero__dot-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('[data-direction="prev"]');
        this.nextButton = this.querySelector('[data-direction="next"]');
        
        this.interval = parseInt(this.dataset.interval) * 1000;
        this.fadeDuration = parseFloat(this.dataset.fadeDuration) * 1000;

        if (this.slides.length > 1) {
          this.preloadNextImage();
          this.startAutoplay();
          this.setupEventListeners();
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.goToSlide(this.currentSlide - 1);
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.goToSlide(this.currentSlide + 1);
          });
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
          });
        });
      }

      startAutoplay() {
        this.intervalId = setInterval(() => {
          this.nextSlide();
        }, this.interval);
      }

      stopAutoplay() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
          this.intervalId = null;
        }
      }

      restartAutoplay() {
        this.stopAutoplay();
        this.startAutoplay();
      }

      nextSlide() {
        this.goToSlide(this.currentSlide + 1);
      }

      goToSlide(index) {
        const previousSlide = this.currentSlide;
        
        if (index < 0) {
          this.currentSlide = this.slides.length - 1;
        } else if (index >= this.slides.length) {
          this.currentSlide = 0;
        } else {
          this.currentSlide = index;
        }

        this.slides[previousSlide].classList.remove('active');
        this.slides[this.currentSlide].classList.add('active');

        this.dots.forEach((dot, i) => {
          if (i === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.preloadNextImage();
        this.restartAutoplay();
      }

      preloadNextImage() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        const nextSlide = this.slides[nextIndex];
        const img = nextSlide.querySelector('img');
        
        if (img && !img.complete) {
          const preloadImg = new Image();
          preloadImg.src = img.src;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('fullscreen-hero-slider-{{ ai_gen_id }}', FullscreenHeroSlider{{ ai_gen_id }});
  })();
</script>

